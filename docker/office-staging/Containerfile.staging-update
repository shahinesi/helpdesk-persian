run("git", "-C", str(ui_temporary), "checkout", "--detach", ui_pin)
ui_actual = subprocess.check_output(["git", "-C", str(ui_temporary), "rev-parse", "HEAD"], text=True).strip()
if ui_actual != ui_pin:
