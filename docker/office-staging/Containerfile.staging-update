import json
import os
import pathlib
import shutil
import subprocess
import sys

apps = pathlib.Path("/home/frappe/frappe-bench/apps")
frappe_base, frappe_pin, erpnext_base, erpnext_pin, helpdesk_base, helpdesk_pin, insights_base, insights_pin, ui_pin = sys.argv[1:]

def run(*args):
    subprocess.run(args, check=True)

def replace_checkout(name, url, base_sha, pinned_sha, node_modules_relative):
    target = apps / name
    temporary = apps / f".{name}-pinned"
    if isinstance(node_modules_relative, (str, pathlib.Path)):
        preserved_modules = (pathlib.Path(node_modules_relative),)
    else:
        preserved_modules = tuple(pathlib.Path(path) for path in node_modules_relative)
    if temporary.exists():
        shutil.rmtree(temporary)
    run("git", "init", str(temporary))
    run("git", "-C", str(temporary), "remote", "add", "upstream", url)
    run("git", "-C", str(temporary), "fetch", "--depth=1", "upstream", pinned_sha)
    run("git", "-C", str(temporary), "fetch", "--depth=1", "upstream", base_sha)
    run("git", "-C", str(temporary), "checkout", "--detach", pinned_sha)
    run("git", "-C", str(temporary), "diff", "--quiet", base_sha, pinned_sha, "--", "requirements.txt", "pyproject.toml", "setup.py")
    package_path = {
        "frappe": pathlib.Path("package.json"),
        "erpnext": pathlib.Path("package.json"),
        "helpdesk": pathlib.Path("desk/package.json"),
        "insights": pathlib.Path("frontend/package.json"),
    }[name]
    package = json.loads((temporary / package_path).read_text(encoding="utf-8"))
    previous_package = json.loads(
        subprocess.check_output(
            ["git", "-C", str(temporary), "show", f"{base_sha}:{package_path.as_posix()}"],
            text=True,
        )
    )
    for field in ("dependencies", "devDependencies", "optionalDependencies"):
        current_deps = package.get(field, {})
        previous_deps = previous_package.get(field, {})
        if name == "insights":
            current_deps = {key: value for key, value in current_deps.items() if key != "frappe-ui"}
            previous_deps = {key: value for key, value in previous_deps.items() if key != "frappe-ui"}
        if current_deps != previous_deps:
            raise SystemExit(f"Unexpected {name} {field} changes; dependency seed must be rebuilt")
    missing_modules = [target / path for path in preserved_modules if not (target / path).is_dir()]
    if missing_modules:
        raise SystemExit(f"Expected installed dependencies are missing: {missing_modules}")
    stale_paths = []
    for current, directories, files in os.walk(target):
        current_path = pathlib.Path(current)
        for directory in list(directories):
            path = current_path / directory
            relative = path.relative_to(target)
            if any(relative == path or path in relative.parents for path in preserved_modules):
                directories.remove(directory)
            elif not any(relative in path.parents for path in preserved_modules):
                stale_paths.append(path)
        stale_paths.extend(current_path / filename for filename in files)
    for path in sorted(stale_paths, key=lambda item: len(item.parts), reverse=True):
        if path.is_symlink() or path.is_file():
            path.unlink()
        elif path.is_dir():
            path.rmdir()
    shutil.copytree(temporary, target, dirs_exist_ok=True)
    shutil.rmtree(temporary)
    actual = subprocess.check_output(["git", "-C", str(target), "rev-parse", "HEAD"], text=True).strip()
    if actual != pinned_sha:
        raise SystemExit(f"{name} SHA mismatch: {actual} != {pinned_sha}")

replace_checkout(
    "frappe",
    "https://github.com/shahinesi/frappe-persian",
    frappe_base,
    frappe_pin,
    pathlib.Path("node_modules"),
)
replace_checkout(
    "erpnext",
    "https://github.com/shahinesi/erpnext-persian",
    erpnext_base,
    erpnext_pin,
    (pathlib.Path("node_modules"), pathlib.Path("banking/node_modules")),
)
replace_checkout(
    "helpdesk",
    "https://github.com/shahinesi/helpdesk-persian",
    helpdesk_base,
    helpdesk_pin,
    pathlib.Path("desk/node_modules"),
)
replace_checkout(
    "insights",
    "https://github.com/shahinesi/insights-persian",
    insights_base,
    insights_pin,
    pathlib.Path("frontend/node_modules"),
)

ui_modules = apps / "insights/frontend/node_modules/frappe-ui"
ui_temporary = apps / "insights/frontend/node_modules/.frappe-ui-pinned"
insights_package = json.loads((apps / "insights/frontend/package.json").read_text(encoding="utf-8"))
if insights_package.get("dependencies", {}).get("frappe-ui", "").split("#")[-1] != ui_pin:
    raise SystemExit("Insights package.json does not reference the pinned Frappe UI SHA")
if ui_temporary.exists():
    shutil.rmtree(ui_temporary)
run("git", "init", str(ui_temporary))
run("git", "-C", str(ui_temporary), "remote", "add", "upstream", "https://github.com/shahinesi/frappe-ui-persian")
run("git", "-C", str(ui_temporary), "fetch", "--depth=1", "upstream", ui_pin)
run("git", "-C", str(ui_temporary), "checkout", "--detach", ui_pin)
ui_actual = subprocess.check_output(["git", "-C", str(ui_temporary), "rev-parse", "HEAD"], text=True).strip()
if ui_actual != ui_pin:
    raise SystemExit(f"Insights Frappe UI SHA mismatch: {ui_actual} != {ui_pin}")
shutil.rmtree(ui_modules)
shutil.move(str(ui_temporary), str(ui_modules))

pins = {
    "frappe": frappe_pin,
    "erpnext": erpnext_pin,
    "helpdesk": helpdesk_pin,
    "telephony": "039cf39f245d6818ead03cf94eea6ce7f9c1e1f7",
    "insights": insights_pin,
    "frappe-ui-insights": ui_pin,
}
seed_pins = json.loads(pathlib.Path("/home/frappe/frappe-bench/PINNED_VERSIONS.json").read_text(encoding="utf-8"))
for app, expected in {
    "frappe": frappe_base,
    "erpnext": erpnext_base,
    "helpdesk": helpdesk_base,
    "telephony": pins["telephony"],
    "insights": insights_base,
}.items():
    if seed_pins.get(app) != expected:
        raise SystemExit(f"Dependency seed {app} SHA mismatch: {seed_pins.get(app)} != {expected}")
(pathlib.Path("/home/frappe/frappe-bench/PINNED_VERSIONS.json")).write_text(
    json.dumps(pins, indent=2) + "\n", encoding="utf-8"
)
PY

