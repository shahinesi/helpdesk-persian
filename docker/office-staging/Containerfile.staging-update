if not ui_modules.is_dir():
    raise SystemExit(f"Installed Frappe UI package is missing: {ui_modules}")
seed_ui_manifest = json.loads((ui_modules / "package.json").read_text(encoding="utf-8"))
pinned_ui_manifest = json.loads((ui_temporary / "package.json").read_text(encoding="utf-8"))
for section in ("dependencies", "optionalDependencies", "peerDependencies"):
