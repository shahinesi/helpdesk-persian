shutil.move(ui_modules / "node_modules", ui_dependencies_temporary)
shutil.rmtree(ui_modules)
shutil.move(ui_temporary, ui_modules)
shutil.move(ui_dependencies_temporary, ui_modules / "node_modules")
updated_format_blob = subprocess.check_output(
    ["git", "hash-object", str(ui_modules / "src/charts/format.ts")], text=True
).strip()
if updated_format_blob != ui_format_blob:
    raise SystemExit(
        f"Updated Frappe UI formatter mismatch: {updated_format_blob} != {ui_format_blob}"
    )

pins = {
