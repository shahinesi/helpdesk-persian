+export function getChartLocale() {
+  if (typeof document === 'undefined') return 'en-US'
+  const language = document.documentElement.lang.toLowerCase().replace('_', '-')
+  return language.startsWith('fa') ? 'fa-IR' : language || 'en-US'
+}
+
+export function getChartFontFamily() {
+  if (typeof document === 'undefined') return 'InterVar, sans-serif'
+  return getComputedStyle(document.documentElement).fontFamily || 'sans-serif'
+}
+
+export function formatPercentage(value: number) {
+  return new Intl.NumberFormat(getChartLocale(), {
+    style: 'percent',
+    maximumFractionDigits: 0,
+  }).format(value / 100)
+}
+
+export function formatSuffix(suffix?: string) {
+  return suffix === '%' && getChartLocale().startsWith('fa') ? '٪' : suffix || ''
+}
